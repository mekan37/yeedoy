{
  "name": "yeedoy-repo",
  "private": true,
  "workspaces": [
    "uygulamalar/web",
    "uygulamalar/mobil",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,MOBILE -c cyan,yellow \"npm --prefix uygulamalar/web run dev\" \"npm --prefix uygulamalar/mobil run dev\"",
    "build": "npm run build:web && npm run build:mobile",
    "lint": "npm run lint:web && npm run lint:mobile",
    "l10n:audit": "node tools/ceviri-denetimi.mjs",
    "test:web": "cd uygulamalar/web && npm run test",
    "test:smoke:web": "cd uygulamalar/web && npm run test:smoke",
    "verify:matrix:lint": "npm run lint:web && npm run lint:mobile",
    "verify:matrix:build": "npm run build:web && npm run build:mobile",
    "verify:matrix": "npm run l10n:audit && npm run verify:matrix:lint && npm run test:smoke:web",
    "ci": "npm run verify:matrix && npm --prefix uygulamalar/mobil run test",
    "hooks:install": "node tools/hook-kur.mjs",
    "clean": "node tools/calisma-alani-islemleri.mjs clean",
    "build:web": "npm --prefix uygulamalar/web run build",
    "build:mobile": "npm --prefix uygulamalar/mobil run build",
    "lint:web": "npm --prefix uygulamalar/web run lint",
    "lint:mobile": "npm --prefix uygulamalar/mobil run lint",
    "build:next": "node tools/calisma-alani-islemleri.mjs build-next",
    "build:all": "node tools/calisma-alani-islemleri.mjs build-all",
    "import:overpass-ilce": "node tools/overpass-ilce-canli-ice-aktar.mjs",
    "import:overpass-ilce:reset": "node tools/overpass-ilce-canli-ice-aktar.mjs --reset",
    "koordinat:duzelt": "node tools/koordinat-duzelt.mjs",
    "koordinat:duzelt:reset": "node tools/koordinat-duzelt.mjs --reset",
    "import:foursquare": "node tools/foursquare-ilce-ice-aktar.mjs",
    "import:foursquare:reset": "node tools/foursquare-ilce-ice-aktar.mjs --reset",
    "import:osm": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf",
    "import:osm:poi": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --sadece=poi",
    "import:osm:sinir": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --sadece=sinir",
    "import:osm:ata-sinir": "node tools/osm-pbf-isle.mjs --sadece=ata-sinir",
    "import:osm:dry": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "firebase": "^12.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dead-code-checker": "^1.1.0",
    "supabase": "^2.98.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": {
      ".": "^15.5.18",
      "postcss": "^8.5.10"
    },
    "protobufjs": "^7.6.5",
    "websocket-driver": "^0.7.5",
    "@grpc/grpc-js": "^1.9.16",
    "ws": "^8.21.1",
    "webpack-bundle-analyzer": {
      "ws": "^7.5.13"
    },
    "lighthouse": {
      "ws": "^7.5.13"
    }
  }
}
