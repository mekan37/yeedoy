{
  "name": "yeedoy-repo",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,MOBILE -c cyan,yellow \"pnpm --filter yeedoy-web run dev\" \"pnpm --filter yeedoy-mobile-flutter run dev\"",
    "build": "pnpm run build:web && pnpm run build:mobile",
    "lint": "pnpm run lint:web && pnpm run lint:mobile",
    "l10n:audit": "node tools/ceviri-denetimi.mjs",
    "test:web": "pnpm --filter yeedoy-web run test",
    "test:smoke:web": "pnpm --filter yeedoy-web run test:smoke",
    "verify:matrix:lint": "pnpm run lint:web && pnpm run lint:mobile",
    "verify:matrix:build": "pnpm run build:web && pnpm run build:mobile",
    "verify:matrix": "pnpm run l10n:audit && pnpm run verify:matrix:lint && pnpm run test:smoke:web",
    "ci": "pnpm run verify:matrix && pnpm --filter yeedoy-mobile-flutter run test",
    "hooks:install": "node tools/hook-kur.mjs",
    "clean": "node tools/calisma-alani-islemleri.mjs clean",
    "build:web": "pnpm --filter yeedoy-web run build",
    "build:mobile": "pnpm --filter yeedoy-mobile-flutter run build",
    "lint:web": "pnpm --filter yeedoy-web run lint",
    "lint:mobile": "pnpm --filter yeedoy-mobile-flutter run lint",
    "build:next": "node tools/calisma-alani-islemleri.mjs build-next",
    "build:all": "node tools/calisma-alani-islemleri.mjs build-all",
    "import:osm": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf",
    "import:osm:poi": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --sadece=poi",
    "import:osm:sinir": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --sadece=sinir",
    "import:osm:ata-sinir": "node tools/osm-pbf-isle.mjs --sadece=ata-sinir",
    "import:osm:dry": "node tools/osm-pbf-isle.mjs --pbf=turkey-260514.osm.pbf --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dead-code-checker": "^1.1.0",
    "supabase": "^2.98.2"
  }
}
