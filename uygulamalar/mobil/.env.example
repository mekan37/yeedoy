# ── Supabase ──────────────────────────────────────────────────────────────────
# Required. Find these in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# ── App identity (optional — defaults shown) ──────────────────────────────────
# APP_NAME=Yeedoy
# APP_SLUG=yeedoy
# WEB_DOMAIN=yeedoy.com
# DEEPLINK_SCHEME=yeedoy

# ── Dev tools (optional) ──────────────────────────────────────────────────────
# Set to true to enable the developer tools menu in debug builds.
# DEV_TOOLS_ENABLED=false
