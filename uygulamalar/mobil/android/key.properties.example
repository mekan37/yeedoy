# Yeedoy Android Release Signing — EXAMPLE FILE
# This file shows the expected format for local development.
# Do NOT commit real values to git — .gitignore protects this.
#
# Local Development:
#   1. Create a keystore: keytool -genkey -v -keystore yeedoy.keystore ...
#   2. Copy this file:    cp key.properties.example key.properties
#   3. Fill in real values from your keystore
#
# CI/CD Environment:
#   Instead of key.properties, set these environment variables:
#   - ANDROID_RELEASE_STORE_FILE     (path to keystore, or base64 decoded)
#   - ANDROID_RELEASE_STORE_PASSWORD (keystore password)
#   - ANDROID_RELEASE_KEY_ALIAS      (alias within keystore)
#   - ANDROID_RELEASE_KEY_PASSWORD   (key password)
#
# See: build.gradle.kts readReleaseSigningValue() function

# Path to the release keystore (relative to android/ directory)
storeFile=app/yeedoy.keystore

# Keystore password (minimum 16 chars, mixed case + numbers + symbols recommended)
storePassword=YOUR_KEYSTORE_PASSWORD_HERE

# Key alias (identifier within keystore, typically app name or company name)
keyAlias=yeedoy-release

# Key password (can be same as storePassword or different)
keyPassword=YOUR_KEY_PASSWORD_HERE
