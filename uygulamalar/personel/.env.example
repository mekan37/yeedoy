# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Ana Supabase projesiyle aynı — personel uygulaması sadece owner_claims'li kullanıcılar için
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# ─── Uygulama Ortamı ──────────────────────────────────────────────────────────
# "development" → Firebase init atlanır (local test için)
# "production"  → Firebase init çalışır (google-services.json / GoogleService-Info.plist gerekli)
APP_ENV=development

# ─── Firebase (Production'da Required) ────────────────────────────────────────
# APP_ENV=production olduğunda Firebase.initializeApp() çağrılır.
# Önce `flutterfire configure` komutunu çalıştırın:
#   cd uygulamalar/personel
#   flutterfire configure
# Bu komut şunları oluşturur:
#   - lib/firebase_options.dart
#   - android/app/google-services.json
#   - ios/Runner/GoogleService-Info.plist
