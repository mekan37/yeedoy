NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional
RESEND_API_KEY=your_resend_api_key_optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PANEL_URL=http://localhost:8080
# Required for POST /api/revalidate (on-demand cache invalidation from deploy pipeline or Supabase webhook)
REVALIDATE_SECRET=your_revalidate_secret_optional
# Required for `npm --prefix apps/web_next run test:e2e:live`
# and `npm --prefix apps/web_next run lighthouse:mobile`
PLAYWRIGHT_SMOKE_BUSINESS_ID=your_live_business_uuid
PLAYWRIGHT_SMOKE_CATEGORY_ID=your_live_category_uuid_optional
PLAYWRIGHT_SMOKE_ITEM_ID=your_live_item_uuid_optional
PLAYWRIGHT_SMOKE_LANG=tr
# Optional: Google Maps Static API key for map thumbnail in menu contact section
NEXT_PUBLIC_GMAPS_KEY=your_gmaps_static_api_key_optional
