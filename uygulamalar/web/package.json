{
  "name": "yeedoy-web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/build.mjs",
    "build:next": "next build",
    "build:analyze": "node ./scripts/build.mjs --analyze",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test e2e/public-menu.spec.ts",
    "test:e2e:live": "node ./scripts/run-playwright-live.mjs",
    "test:e2e:headed": "playwright test --headed",
    "lighthouse:mobile": "node ./scripts/lighthouse-mobile.mjs",
    "lighthouse:qr:auth": "node ./scripts/lighthouse-qr-auth.mjs",
    "test:smoke": "pnpm run typecheck && pnpm run lint",
    "test": "pnpm run test:smoke && pnpm run test:unit",
    "test:ci": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.100.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^6.0.0",
    "next": "^16.2.11",
    "pmtiles": "^4.4.1",
    "protomaps-themes-base": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.9.2",
    "replicate": "^1.4.0",
    "resend": "^6.18.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
