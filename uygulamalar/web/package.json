  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/build.mjs",
    "build:next": "next build",
    "build:analyze": "node ./scripts/build.mjs --analyze",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test e2e/public-menu.spec.ts",
    "test:e2e:live": "node ./scripts/run-playwright-live.mjs",
    "test:e2e:headed": "playwright test --headed",
    "lighthouse:mobile": "node ./scripts/lighthouse-mobile.mjs",
    "lighthouse:qr:auth": "node ./scripts/lighthouse-qr-auth.mjs",
    "test:smoke": "npm run typecheck && npm run lint",
    "test": "npm run test:smoke && npm run test:unit",
    "test:ci": "npm run test && npm run build"
  },
  "dependencies": {
